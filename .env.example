# URL da Supabase Edge Function que fala com a API da Anthropic.
# Ex.: https://SEU-PROJETO.supabase.co/functions/v1/gerar-plano
VITE_IA_ENDPOINT=

# Chave publishable (anon) do projeto Supabase — usada só para autenticar a chamada da function.
# NUNCA coloque a chave da Anthropic aqui: ela vive apenas nos secrets do Supabase.
VITE_SUPABASE_ANON_KEY=
