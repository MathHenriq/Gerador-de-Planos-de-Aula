{
  "name": "gerador-de-planos-de-aula",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Gerador de plano de aula semanal do Núcleo WIT — PDF institucional gerado no navegador.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "amostra": "tsx --tsconfig tsconfig.scripts.json scripts/render-sample.mts",
    "metricas": "tsx --tsconfig tsconfig.scripts.json scripts/gerar-metricas.mts",
    "conferir-bncc": "tsx --tsconfig tsconfig.scripts.json scripts/conferir-bncc.mts"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.1.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fontkit": "^2.0.4",
    "pdfjs-dist": "^6.2.108",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
